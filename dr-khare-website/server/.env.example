# Core Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Security & JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRE=7d
CORS_ORIGIN=http://localhost:5000

# Cloudinary (Image & Video Hosting)
# If left blank, the system defaults to "demo mode" and saves files locally to server/uploads/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Communication (Nodemailer via SMTP for Contact Forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=contact@supreetkhare.com

# AI Assistant integration (For external chatbot backend)
OPENAI_API_KEY=your_openai_api_key_here
